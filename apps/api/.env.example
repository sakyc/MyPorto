NODE_ENV=development
HOST=127.0.0.1
PORT=4000
WEB_ORIGIN=http://localhost:3000
# Required. URL-encode special characters in the password; use a dedicated user.
DATABASE_URL=mysql://nuansua_app:REPLACE_PASSWORD@127.0.0.1:3306/nuansua-api
API_PUBLIC_URL=http://localhost:4000
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ANALYTICS_SALT_SECRET=REPLACE_WITH_ANOTHER_32_RANDOM_CHARACTERS
REVALIDATE_SECRET=REPLACE_WITH_SHARED_WEB_SECRET_32_OR_MORE
REVALIDATE_URL=http://localhost:3000/api/revalidate
UPLOAD_DIR=./data/uploads
OWNER_EMAIL=owner@example.com
COOKIE_SAME_SITE=lax
# Keep COOKIE_DOMAIN unset with the default first-party admin proxy.
# COOKIE_DOMAIN=
TRUST_PROXY=0
# Integration tests create/drop only nuansua-api-test-<pid>, using this admin URL.
# TEST_MYSQL_URL=mysql://root@127.0.0.1:3306/
