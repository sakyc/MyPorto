NEXT_PUBLIC_API_URL=http://localhost:4000
# Server-side published content and admin proxy destination (VPS URL in production).
API_URL=http://127.0.0.1:4000
SITE_URL=http://localhost:3000
# Must match the API's REVALIDATE_SECRET.
REVALIDATE_SECRET=REPLACE_WITH_SHARED_WEB_SECRET_32_OR_MORE
# Leave empty: admin uses same-origin /api/admin proxied to the VPS.
NEXT_PUBLIC_ADMIN_API_URL=
